{
  "name": "pi-subagents",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent orchestration: spawn, steer, resume, and schedule subagents in-process via createAgentSession, with worktree isolation and grouped completion notifications.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "orchestration",
    "multi-agent",
    "pi"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "croner": "^9.0.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.0.0",
    "@earendil-works/pi-tui": "0.81.1"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "exports": {
    ".": "./extensions/index.ts"
  },
  "files": [
    "extensions/**/*.ts",
    "!extensions/**/test/**",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/echohub-ai/pi-extensions"
  }
}
