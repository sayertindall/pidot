{
	"name": "pi-runtime-notrace",
	"version": "0.1.0",
	"type": "module",
	"description": "Generate readable, self-contained HTML session retrospectives",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi"
	],
	"license": "MIT",
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"vitest": "^4.1.8",
		"@biomejs/biome": "^2.5.0",
		"@types/node": "^22.0.0"
	},
	"exports": {
		".": "./extensions/index.ts"
	},
	"files": [
		"extensions/**/*.ts",
		"!extensions/**/test/**",
		"README.md",
		"SPEC.md"
	],
	"scripts": {
		"lint": "biome check",
		"format": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/echohub-ai/pi-extensions"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	}
}
