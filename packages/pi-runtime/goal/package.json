{
  "name": "pi-runtime-goal",
  "version": "0.1.0",
  "type": "module",
  "description": "Long-running main-agent goal with automatic context-budget handoff. Keep working until the goal is actually done.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "goal",
    "runtime",
    "session-lifecycle",
    "pi"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "@biomejs/biome": "^2.5.0",
    "typebox": "*",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "exports": {
    ".": "./extensions/index.ts"
  },
  "files": [
    "extensions/**/*.ts",
    "!extensions/**/test/**",
    "README.md",
    "SPEC.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/echohub-ai/pi-extensions"
  }
}
