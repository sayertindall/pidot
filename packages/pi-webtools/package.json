{
  "name": "pi-webtools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["pi-package", "pi-extension", "web", "search", "fetch"],
  "pi": {
