{
  "name": "pi-toolkit-session-control",
  "version": "0.1.0",
  "description": "Always-on session bus — Unix socket RPC for inter-session communication",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-agent",
    "pi-package",
    "extension",
    "session-control",
    "session-bus",
    "ipc"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions/**/*.ts",
    "!extensions/**/test/**",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "exports": {
    ".": "./extensions/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/echohub-ai/pi-extensions"
  }
}
