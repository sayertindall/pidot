{
	"name": "pi-process-shared",
	"version": "0.1.0",
	"type": "module",
	"description": "Shared helpers for the pi-process extensions: safeExec discipline, TerminalStatus mapping, RunRecord persistence, confirmation injection, paths under ~/.pi/agent/pi-process/.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"process",
		"subprocess",
		"pty",
		"pi"
	],
	"license": "MIT",
	"exports": {
		".": "./extensions/index.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"vitest": "^4.1.8",
		"@biomejs/biome": "^2.5.0",
		"@types/node": "^22.0.0"
	},
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"files": [
		"extensions/**/*.ts",
		"!extensions/**/test/**",
		"README.md"
	],
	"scripts": {
		"lint": "biome check",
		"format": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/echohub-ai/pi-extensions"
	}
}
