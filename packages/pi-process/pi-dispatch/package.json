{
  "name": "pi-dispatch",
  "version": "0.1.0",
  "type": "module",
  "description": "PTY-based dispatch engine: run an arbitrary CLI in a real pseudo-terminal, supervise it (interactive / hands-free / dispatch / monitor), report back reliably when it's done.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pty",
    "terminal",
    "dispatch",
    "subagent",
    "pi"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "pi-process-shared": "link:../_shared",
    "zigpty": "^0.1.6"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.0.0",
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "exports": {
    ".": "./extensions/index.ts"
  },
  "files": [
    "extensions/**/*.ts",
    "!extensions/**/test/**",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/echohub-ai/pi-extensions"
  }
}