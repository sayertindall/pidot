{
	"name": "pi-ssh",
	"version": "0.1.0",
	"type": "module",
	"description": "Explicit SSH command execution for pi. Highest-privilege thing in the package: confirmation required, every invocation logged.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"ssh",
		"remote-execution",
		"pi"
	],
	"license": "MIT",
	"exports": {
		".": "./extensions/index.ts"
	},
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"files": [
		"extensions/**/*.ts",
		"!extensions/**/test/**",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*",
		"@earendil-works/pi-tui": "*",
		"@earendil-works/pi-ai": "*"
	},
	"dependencies": {
		"pi-process-shared": "link:../_shared"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		}
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"vitest": "^4.1.8",
		"@biomejs/biome": "^2.5.0",
		"@types/node": "^22.0.0",
		"@earendil-works/pi-tui": "0.81.1",
		"@earendil-works/pi-ai": "0.81.1"
	},
	"scripts": {
		"lint": "biome check",
		"format": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/echohub-ai/pi-extensions"
	}
}
